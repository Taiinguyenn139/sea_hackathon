{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","run_id","status","split","backend","repetitions","results","summary","metadata"],
  "properties": {
    "schema_version":{"const":1},
    "run_id":{"type":"string","pattern":"^run-[a-zA-Z0-9-]+$"},
    "status":{"enum":["completed","incomplete"]},
    "split":{"enum":["dev","heldout"]},
    "backend":{"enum":["rules","llm"]},
    "repetitions":{"type":"integer","minimum":1},
    "results":{"type":"array","minItems":1},
    "summary":{"type":"object","required":["no_memory","full_history","harness"]},
    "metadata":{"type":"object","required":["oracle_hash","scenario_hash","expected_results"]}
  }
}
