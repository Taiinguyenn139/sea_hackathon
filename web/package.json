{
  "name": "memory-harness-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node tests/live-smoke.mjs",
    "format": "prettier --write src tests package.json vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json index.html"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
