# Local development only. Production credentials are generated in Secret Manager.
APP_ENV=development
HARNESS_DB=data/harness.sqlite3
COOKIE_SECURE=false
ADMIN_TOKEN=local-demo-admin-change-before-use
STAFF_PASSWORD=local-demo-staff-change-before-use
LLM_BACKEND=rules
# Requires LLM_BACKEND=openai plus the primary/backup credentials below.
AI_SPECIALIST_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BACKUP_MODEL=
LLM_CALL_BUDGET_SECONDS=20
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
